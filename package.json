{
  "name": "chinookdb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-data.mjs && node scripts/generate-model.mjs",
    "dev": "pnpm generate && astro dev",
    "build": "pnpm generate && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate-data.mjs",
    "test:data": "node --test scripts/test-data.mjs",
    "test:model": "node --test scripts/test-model.mjs",
    "test:tools": "node --test scripts/test-tools.mjs",
    "tools:install": "node scripts/install-tools.mjs --dir .tools/bin",
    "lint:model": "node scripts/run-tool.mjs modelspec lint --profile publish model",
    "check:model-twin": "node scripts/run-tool.mjs modelspec export --check model/chinook.modelspec.hcl model/chinook.modelspec.json",
    "check:meaning": "node scripts/check-meaning.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:ovdb": "node scripts/check-ovdb-manifest.mjs --repository https://github.com/datatug/chinookdb",
    "check:drift": "node scripts/check-data-drift.mjs",
    "test:worker": "node --import tsx/esm scripts/test-worker.ts"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.38.0"
  }
}
