---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tables, tablePath } from '../../../data/model';

const totalRows = tables.reduce((sum, table) => sum + table.rowCount, 0);
const connectionUrl = 'https://chinookdb.com/ovdb/dbs/chinook';
---
<BaseLayout title="Chinook OpenVaultDB database | ChinookDB" description="The canonical OpenVaultDB connection and database profile for Chinook." canonical="/ovdb/dbs/chinook">
  <section class="page-intro shell">
    <a class="back-link" href="/ovdb/dbs/">← Databases</a>
    <p class="eyebrow">OpenVaultDB database · read-only</p>
    <h1>Chinook</h1>
    <p>A public sample database of a digital music store. Explore its schema and records here, or connect a client through OpenVaultDB discovery.</p>
  </section>
  <section class="shell profile-layout">
    <div class="content-card">
      <h2>Connection</h2>
      <p>This URL is the stable database identity and a browser destination. Clients discover the independently versioned API through the server discovery document.</p>
      <code class="connection-url">{connectionUrl}</code>
      <div class="profile-links"><a class="text-link" href="/.well-known/openvaultdb">Discovery document →</a><a class="text-link" href="/ovdb/v1/databases/chinook">Machine metadata →</a></div>
    </div>
    <div class="content-card">
      <h2>At a glance</h2>
      <dl><div><dt>Database ID</dt><dd><code>chinook</code></dd></div><div><dt>Provider</dt><dd>Static JSON</dd></div><div><dt>Schema</dt><dd>Strict</dd></div><div><dt>Access</dt><dd>Anonymous, read-only</dd></div><div><dt>Capabilities</dt><dd>Record read and query</dd></div><div><dt>Tables</dt><dd>{tables.length} · {totalRows.toLocaleString()} fixture rows</dd></div></dl>
    </div>
  </section>
  <section class="shell section table-section">
    <div class="section-heading"><div><p class="eyebrow">Schema overview</p><h2>Explore the tables</h2></div><a class="text-link" href="/tables/">Full schema →</a></div>
    <div class="table-grid">{tables.map((table) => <a class="table-card" href={tablePath(table.name)}><div class="table-card-top"><span class="table-icon" aria-hidden="true">{table.name.slice(0, 2)}</span><span class="row-count">{table.rowCount.toLocaleString()} rows</span></div><strong>{table.name}</strong><span class="table-card-description">{table.description}</span><span class="table-card-columns">{table.columns.length} columns</span></a>)}</div>
  </section>
</BaseLayout>
<style>
  .profile-layout { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr); gap:18px; padding-bottom:70px; }
  .profile-layout p { color:var(--muted); margin:15px 0 20px; }
  .connection-url { display:block; overflow-wrap:anywhere; padding:14px; background:#0c1829; border:1px solid var(--line); color:var(--cyan); }
  .profile-links { display:flex; flex-wrap:wrap; gap:22px; margin-top:20px; }
  dl { display:grid; gap:9px; margin:18px 0 0; }
  dl div { display:flex; justify-content:space-between; gap:15px; border-bottom:1px solid var(--line); padding:5px 0; font-size:13px; }
  dt { color:var(--faint); } dd { margin:0; text-align:right; }
  @media(max-width:800px) { .profile-layout { grid-template-columns:1fr; } }
</style>
