---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tables } from '../../../data/model';

const totalRows = tables.reduce((sum, table) => sum + table.rowCount, 0);
---
<BaseLayout title="OpenVaultDB databases | ChinookDB" description="Databases published by the ChinookDB OpenVaultDB server.">
  <section class="page-intro shell">
    <a class="back-link" href="/ovdb/">← OVDB server</a>
    <p class="eyebrow">Database catalogue</p>
    <h1>Databases</h1>
    <p>Browse databases exposed by this server. Each profile has a stable browser URL and links to its machine API.</p>
  </section>
  <section class="shell section">
    <article class="content-card database-card">
      <div>
        <p class="eyebrow">Public · read-only</p>
        <h2><a href="/ovdb/dbs/chinook">Chinook <span aria-hidden="true">→</span></a></h2>
        <p>The digital music store fixture: artists, albums, tracks, customers, invoices, and their relationships.</p>
      </div>
      <dl><div><dt>ID</dt><dd><code>chinook</code></dd></div><div><dt>Provider</dt><dd>Static JSON</dd></div><div><dt>Schema</dt><dd>{tables.length} tables · {totalRows.toLocaleString()} rows</dd></div><div><dt>Capabilities</dt><dd>Read records · query records</dd></div></dl>
    </article>
  </section>
</BaseLayout>
<style>
  .database-card { display:grid; grid-template-columns:1fr 1fr; gap:35px; }
  .database-card h2 a:hover { color:var(--lime); }
  .database-card p:not(.eyebrow) { color:var(--muted); margin:14px 0 0; }
  dl { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin:0; }
  dt { color:var(--faint); font-size:12px; } dd { margin:4px 0 0; font-size:13px; }
  @media(max-width:700px) { .database-card { grid-template-columns:1fr; } }
  @media(max-width:450px) { dl { grid-template-columns:1fr; } }
</style>
