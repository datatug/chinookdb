---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tables, tablePath } from '../../data/model';

export function getStaticPaths() {
  return tables.map((table) => ({ params: { table: table.name }, props: { table } }));
}

const { table } = Astro.props;
const previewRows = table.rows.slice(0, 8);
const keys = table.columns.map((column) => column.name);
const related = [...new Set(table.foreignKeys.flatMap((foreignKey) => [foreignKey.table]))];
const inbound = tables.filter((candidate) => candidate.foreignKeys.some((foreignKey) => foreignKey.table === table.name)).map((candidate) => candidate.name);
---
<BaseLayout title={`${table.name} Table — Chinook Database | ChinookDB`} description={`${table.description} View ${table.name} columns, relationships, preview rows, and downloads.`} canonical={`/tables/${table.name}/`}>
  <section class="table-hero shell"><div><a class="back-link" href="/tables/">← All tables</a><p class="eyebrow">Chinook table</p><h1>{table.name}</h1><p>{table.description}</p></div><div class="table-hero-stat"><strong>{table.rowCount.toLocaleString()}</strong><span>rows</span></div></section>
  <section class="shell table-layout"><div class="table-main"><div class="content-card"><div class="card-heading"><div><p class="eyebrow">Columns</p><h2>Schema</h2></div><span class="muted">{table.columns.length} columns</span></div><div class="schema-scroll"><table class="schema-table"><thead><tr><th>Column</th><th>Type</th><th>Nullable</th><th>Key</th><th>References</th></tr></thead><tbody>{table.columns.map((column) => { const fk = table.foreignKeys.find((foreignKey) => foreignKey.column === column.name); return <tr><th scope="row"><code>{column.name}</code></th><td><code>{column.type}</code></td><td>{column.nullable ? 'yes' : 'no'}</td><td>{column.primaryKey ? <span class="key-badge">PK</span> : '—'}</td><td>{fk ? <a href={tablePath(fk.table)}><code>{fk.table}.{fk.referencedColumn}</code></a> : '—'}</td></tr> })}</tbody></table></div></div><div class="content-card"><div class="card-heading"><div><p class="eyebrow">First {previewRows.length} rows</p><h2>Data preview</h2></div><span class="muted">of {table.rowCount.toLocaleString()}</span></div><div class="preview-scroll"><table class="preview-table"><thead><tr>{keys.map((key) => <th scope="col"><code>{key}</code></th>)}</tr></thead><tbody>{previewRows.map((row) => <tr>{keys.map((key) => <td>{row[key] === null ? <span class="null-value">null</span> : String(row[key])}</td>)}</tr>)}</tbody></table></div></div></div><aside class="table-aside"><div class="content-card download-card"><p class="eyebrow">Download this table</p><h2>Choose a format</h2><div class="download-links"><a href={`/data/json/chinook.${table.name}.json`} download><span>JSON</span><b>↓</b></a><a href={`/data/yaml/chinook.${table.name}.yaml`} download><span>YAML</span><b>↓</b></a><a href={`/data/csv/chinook.${table.name}.csv`} download><span>CSV</span><b>↓</b></a><a href={`/data/sql/chinook.${table.name}.sql`} download><span>SQL</span><b>↓</b></a></div></div><div class="content-card"><p class="eyebrow">Relationships</p><h2>Connected tables</h2>{related.length || inbound.length ? <div class="related-list">{related.map((name) => <a href={tablePath(name)}><span>→</span>{name}</a>)}{inbound.map((name) => <a href={tablePath(name)}><span>←</span>{name}</a>)}</div> : <p class="muted">No foreign-key relationships.</p>}</div><div class="content-card source-card"><p class="eyebrow">Source</p><p>Generated from the canonical upstream SQLite fixture.</p><a class="text-link" href="/about/">Attribution &amp; licence →</a></div></aside></section>
</BaseLayout>
