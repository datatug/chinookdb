---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tables, tablePath } from '../../data/model';

export function getStaticPaths() {
  return tables.map((table) => ({ params: { table: table.name }, props: { table } }));
}

const { table } = Astro.props;
const related = [...new Set(table.foreignKeys.flatMap((foreignKey) => [foreignKey.table]))];
const inbound = tables.filter((candidate) => candidate.foreignKeys.some((foreignKey) => foreignKey.table === table.name)).map((candidate) => candidate.name);
---
<BaseLayout title={`${table.name} Table — Chinook Database | ChinookDB`} description={`${table.description} View ${table.name} columns, relationships, preview rows, and downloads.`} canonical={`/tables/${table.name}/`}>
  <section class="table-hero shell"><div><a class="back-link" href="/tables/">← All tables</a><p class="eyebrow">Chinook table</p><h1>{table.name}</h1><p>{table.description}</p></div><div class="table-hero-stat"><strong>{table.rowCount.toLocaleString()}</strong><span>rows</span></div></section>
  <section class="shell table-layout"><div class="table-main"><div class="content-card"><div class="card-heading"><h2>{table.columns.length} columns</h2></div><div class="schema-scroll"><table class="schema-table"><thead><tr><th>Column</th><th>Type</th><th>Nullable</th><th>Key</th><th>References</th></tr></thead><tbody>{table.columns.map((column) => { const fk = table.foreignKeys.find((foreignKey) => foreignKey.column === column.name); return <tr><th scope="row"><code>{column.name}</code></th><td><code>{column.type}</code></td><td>{column.nullable ? 'yes' : 'no'}</td><td>{column.primaryKey ? <span class="key-badge">PK</span> : '—'}</td><td>{fk ? <a href={tablePath(fk.table)}><code>{fk.table}.{fk.referencedColumn}</code></a> : '—'}</td></tr> })}</tbody></table></div></div><div class="content-card"><div class="card-heading"><div><p class="eyebrow">Interactive DataTug embed</p><h2>Explore {table.name} data</h2></div><span class="muted">{table.rowCount.toLocaleString()} rows available</span></div>{table.name === 'Album' ? <datatug-grid connection="https://chinookdb.com/ovdb/dbs/chinook"><dtql-query>{`from: {name: Album}\nwhere: {op: ">=", left: {field: ArtistId}, right: {param: MinArtistID}}\norderBy: [{field: AlbumId}]\nlimit: 50`}</dtql-query><dtql-param name="MinArtistID" value="1" type="number" /></datatug-grid> : <datatug-grid data-url={`/data/json/chinook.${table.name}.json`}></datatug-grid>}<noscript><p>The interactive grid requires JavaScript. Download the data in JSON or CSV using the links on this page.</p></noscript></div></div><aside class="table-aside"><div class="content-card download-card"><p class="eyebrow">Download this table</p><h2>Choose a format</h2><div class="download-links"><a href={`/data/json/chinook.${table.name}.json`} download><span>JSON</span><b>↓</b></a><a href={`/data/yaml/chinook.${table.name}.yaml`} download><span>YAML</span><b>↓</b></a><a href={`/data/csv/chinook.${table.name}.csv`} download><span>CSV</span><b>↓</b></a><a href={`/data/sql/chinook.${table.name}.sql`} download><span>SQL</span><b>↓</b></a></div></div><div class="content-card"><p class="eyebrow">Relationships</p><h2>Connected tables</h2>{related.length || inbound.length ? <div class="related-list">{related.map((name) => <a href={tablePath(name)}><span>→</span>{name}</a>)}{inbound.map((name) => <a href={tablePath(name)}><span>←</span>{name}</a>)}</div> : <p class="muted">No foreign-key relationships.</p>}</div><div class="content-card source-card"><p class="eyebrow">Source</p><p>Generated from the canonical upstream SQLite fixture.</p><a class="text-link" href="/about/">Attribution &amp; licence →</a></div></aside></section>
  <script is:inline type="module" src="/embed/datatug.js"></script>
</BaseLayout>

<style>
  .schema-scroll { margin-bottom: -25px; }
  .schema-table tbody tr:last-child > * { border-bottom: 0; }
  datatug-grid {
    display: block; margin: 0 -25px -25px; min-height: 240px;
    --datatug-bg: var(--panel); --datatug-fg: var(--ink);
    --datatug-muted: var(--muted); --datatug-border: var(--line);
    --datatug-header-bg: var(--panel-2); --datatug-hover: #1b304b;
    --datatug-selected: #25415e; --datatug-accent: var(--lime);
    --datatug-button-bg: var(--panel-2); --datatug-error: #ff9ca5;
    --datatug-radius: 0 0 7px 7px;
  }
</style>
