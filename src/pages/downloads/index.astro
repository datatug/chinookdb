---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tables } from '../../data/model';
---
<BaseLayout title="Downloads — Chinook Database | ChinookDB" description="Download the complete Chinook sample database as SQLite, JSON, YAML, PostgreSQL, MySQL, or SQL Server SQL.">
  <section class="page-intro shell"><p class="eyebrow">Data access</p><h1>Downloads</h1><p>Use the complete database when you need the full relational fixture, or pick a table-level file for a focused example.</p></section>
  <section class="shell section"><div class="download-layout"><div><div class="section-heading compact"><div><p class="eyebrow">Complete database</p><h2>Everything in one file.</h2></div></div><div class="big-download-list"><a href="/data/chinook.sqlite" download><span><strong>SQLite</strong><small>Ready-to-query embedded database</small></span><b>↓</b></a><a href="/data/chinook.json" download><span><strong>JSON</strong><small>All tables keyed by canonical name</small></span><b>↓</b></a><a href="/data/chinook.yaml" download><span><strong>YAML</strong><small>Human-readable complete dataset</small></span><b>↓</b></a><a href="/data/chinook.postgresql.sql" download><span><strong>PostgreSQL SQL</strong><small>Upstream database script</small></span><b>↓</b></a><a href="/data/chinook.mysql.sql" download><span><strong>MySQL SQL</strong><small>Upstream database script</small></span><b>↓</b></a><a href="/data/chinook.sqlserver.sql" download><span><strong>SQL Server SQL</strong><small>Upstream database script</small></span><b>↓</b></a></div></div><div class="download-aside"><div class="content-card"><p class="eyebrow">Individual tables</p><h2>Small, focused fixtures.</h2><p>Every table is available in JSON, YAML, CSV, and standalone SQL. Open a table to see its schema and preview first.</p><div class="mini-table-list">{tables.map((table) => <a href={`/tables/${table.name}/`}><span>{table.name}</span><small>{table.rowCount.toLocaleString()} rows →</small></a>)}</div></div></div></div></section>
  <section class="shell section url-contract"><div><p class="eyebrow">Stable URL contract</p><h2>Predictable paths for tooling.</h2></div><pre><code>/data/chinook.*                    complete database
/data/&lt;format&gt;/chinook.&lt;Table&gt;.*   individual table</code></pre></section>
</BaseLayout>
